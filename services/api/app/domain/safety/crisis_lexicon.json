{
  "version": "crisis-rules-2026.10.2",
  "about": "Crisis phrase rules. Patterns run on normalised text (lower case, apostrophes removed, stretched letters shortened). An identical copy lives in services/api/app/domain/safety/crisis_lexicon.json so detection still works when this service is down; a test in each service checks the copies match. Changes need clinical sign-off and a run of the safety suites. Version 2026.10.2 closes 13 gaps the owner asked to fix before clinical review; that review is still pending.",
  "third_person_words": ["he", "she", "they", "him", "her", "them", "his", "hers", "their", "friend", "friends", "roommate", "classmate", "brother", "sister", "cousin", "someone", "somebody", "partner", "boyfriend", "girlfriend"],
  "first_person_words": ["i", "im", "ive", "id", "ill", "me", "my", "myself", "mine"],
  "imminence": [
    {"id": "IM-TIME", "pattern": "\\b(?:tonight|today|right now|this (?:evening|morning|afternoon|weekend)|in an hour|after (?:class|this|everyone sleeps)|before (?:morning|tomorrow))\\b"},
    {"id": "IM-MEANS", "pattern": "\\b(?:have|got|bought|collected|saved|saving|stockpiled|stockpiling|kept|keeping|hoarding)\\b(?:\\s+\\w+){0,3}\\s+(?:pills|tablets|rope|blades?|razors?|gun|knife|poison|pesticide)\\b"},
    {"id": "IM-NOTE", "pattern": "\\b(?:wrote|written|writing|left|leaving)\\s+(?:a|my)\\s+(?:note|letter|goodbye)\\b"},
    {"id": "IM-PLAN", "pattern": "\\b(?:i have a plan|ive planned|i planned|planning to|decided to|made up my mind|its time)\\b"},
    {"id": "IM-GOODBYE", "pattern": "\\b(?:goodbye|saying goodbye|said goodbye|last message|wont see me again)\\b"}
  ],
  "rules": [
    {"id": "SI-KILL-SELF", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\b(?:kill|killing|end|ending|take|taking)\\s+(?:my\\s?self|my\\s+(?:own\\s+)?life)\\b"},
    {"id": "SI-SUICIDE", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\bsuicid\\w*"},
    {"id": "SI-WANT-DIE", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:want|wants|wann?a|wanted|wish|wishing|planning|plan|ready|tempted|thinking about|thought about|deserve)\\s+(?:to\\s+)?(?:die|be dead|not be alive|not exist|stop existing|stop living)\\b"},
    {"id": "SI-NOT-LIVE", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:dont|do not|no longer|never)\\s+want\\s+to\\s+(?:be alive|live|exist|wake up|be here anymore|be around anymore|go on)\\b"},
    {"id": "SI-END-ALL", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:end|ending|finish)\\s+it\\s+all\\b|\\bend\\s+everything\\b|\\bgive up on (?:life|living)\\b"},
    {"id": "SI-NO-REASON", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:no|not any|nothing to)\\s+(?:reason|point)\\s+(?:to|in)\\s+(?:live|living|going on|being alive|staying alive)\\b"},
    {"id": "SI-BETTER-OFF", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\b(?:better off|be better)\\s+(?:dead|without me|if i (?:was|were) gone|if i (?:wasnt|werent) here)\\b|\\bif i (?:was|were) gone\\b"},
    {"id": "SI-WISH-DEAD", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\bwish i (?:was|were|could be) (?:dead|never born|gone forever)\\b|\\bsleep and (?:never|not) wake up\\b"},
    {"id": "SI-SLANG", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\bkms\\b|\\bunalive (?:my\\s?self|me)\\b|\\bcatch the bus forever\\b"},
    {"id": "SI-JUMP", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\bjump(?:ing)?\\s+(?:off|from|in front of)\\s+(?:a|the|my)?\\s*(?:roof|rooftop|terrace|building|bridge|train|tracks|balcony|cliff|hostel)\\b|\\b(?:hang|hanging)\\s+my\\s?self\\b"},
    {"id": "SI-HINGLISH", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\b(?:khud\\s?kushi|aatm\\s?hatya|atma?\\s?hatya|suicide kar)\\w*|\\bmar\\s?(?:jana|jaana|jaun|jaunga|jaungi|na|ne)\\s+(?:chahta|chahti|hai|hoon|hu|chahiye)\\b|\\bjeena\\s+nahi\\s+(?:chahta|chahti|hai)\\b|\\bzindagi\\s+(?:khatam|khtm)\\s+(?:kar|karna|karni|karunga|karungi)\\b"},
    {"id": "SI-HINDI", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "(?:आत्महत्या|खुदकुशी|ख़ुदकुशी|मरना\\s*चाहता|मरना\\s*चाहती|मर\\s*जाना\\s*चाहता|मर\\s*जाना\\s*चाहती|जीना\\s*नहीं\\s*चाहता|जीना\\s*नहीं\\s*चाहती|ज़िंदगी\\s*ख़त्म|जिंदगी\\s*खत्म)"},
    {"id": "SH-HURT-SELF", "category": "self_harm", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\b(?:hurt|hurting|harm|harming|cut|cutting|burn|burning|punish|punishing|injure|injuring|starve|starving)\\s+my\\s?self\\b"},
    {"id": "SH-SELF-HARM", "category": "self_harm", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\bself[\\s-]?harm\\w*|\\bself[\\s-]?injur\\w*"},
    {"id": "SH-RELAPSE", "category": "self_harm", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:started|start|been|keep|kept|back to)\\s+cutting(?:\\s+again)?\\b|\\bcutting again\\b|\\brelapsed? (?:on|into) (?:cutting|self[\\s-]?harm)\\b"},
    {"id": "SH-OVERDOSE", "category": "self_harm", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\boverdos\\w*|\\boded\\b|\\b(?:want to|going to|gonna|might|will)\\s+od\\b|\\b(?:took|take|taking|swallowed|swallow)\\s+(?:too many|a lot of|all (?:my|the|of my)|a bunch of|the whole (?:bottle|strip) of)\\s+(?:pills|tablets|meds|medicine|sleeping pills)\\b"},
    {"id": "HO-HURT-OTHERS", "category": "harm_to_others", "severity": "moderate", "action": "escalate", "self_directed": false, "pattern": "\\b(?:kill|hurt|shoot|stab|attack|poison)\\s+(?:him|her|them|someone|somebody|people|everyone|everybody|my (?:roommate|professor|teacher|dad|mom|father|mother|brother|sister|partner|boyfriend|girlfriend|ex|classmates?|friends?))\\b"},
    {"id": "HO-WEAPON", "category": "harm_to_others", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\b(?:bring|brought|bringing|have|got|carry|carrying)\\s+a\\s+(?:gun|weapon|knife|bomb)\\s+(?:to|into|in)\\s+(?:class|campus|school|college|the hostel|the lecture|the exam)\\b|\\bshoot up (?:the|my) (?:school|college|class|campus)\\b"},
    {"id": "AU-HURTS-ME", "category": "abuse_or_unsafe_situation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\b(?:he|she|they|someone|somebody|my \\w+)\\s+(?:hits|hit|beats|beat|abuses|abused|rapes|raped|assaults|assaulted|touches|touched|chokes|choked|threatens|threatened|is hurting|keeps hurting)\\s+me\\b(?!\\s+up\\b)"},
    {"id": "AU-BEING-ABUSED", "category": "abuse_or_unsafe_situation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\b(?:being|been|was|got|getting)\\s+(?:abused|assaulted|raped|molested|stalked|beaten|blackmailed|trafficked)\\b"},
    {"id": "AU-UNSAFE", "category": "abuse_or_unsafe_situation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\b(?:dont|do not|no longer)\\s+feel\\s+safe\\s+(?:at|in)\\s+(?:home|my room|my hostel|the hostel|my house|my flat|my apartment)\\b|\\b(?:afraid|scared|terrified)\\s+(?:that\\s+)?(?:he|she|they|hes|shes|theyre)(?:ll|\\s+will|\\s+is going to|\\s+are going to|\\s+going to|\\s+might)\\s+(?:hurt|kill)\\s+me\\b|\\bthreaten\\w*\\s+to\\s+(?:hurt|kill|leak)\\s+(?:me|my)\\b"},
    {"id": "AD-HELP-NOW", "category": "acute_distress", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\bi\\s+need\\s+(?:help|someone|somebody)\\s+(?:right\\s+)?now\\b(?!\\s+(?:with|on|for|to)\\b)|\\bplease\\s+(?:call|get|send)\\s+(?:someone|somebody|help|an ambulance|the police)\\b|\\b(?:this is|im having|i am having)\\s+an\\s+emergency\\b"},
    {"id": "AD-PANIC-NOW", "category": "acute_distress", "severity": "moderate", "action": "escalate", "self_directed": false, "pattern": "\\b(?:having|in the middle of|cant stop)\\s+(?:a\\s+)?panic attack\\b|\\bcant breathe\\b"},
    {"id": "AD-CANT-GO-ON", "category": "acute_distress", "severity": "moderate", "action": "escalate", "self_directed": false, "pattern": "\\bcant go on\\b|\\bcannot go on\\b|\\bcant keep living\\b|\\bcant live like this\\b"},
    {"id": "SI-KILL-REFLEX", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:killmyself|kill(?:ing)?\\s+(?:her|his|their)self)(?![-\\w])"},
    {"id": "SI-END-LIFE", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:end|ending)\\s+(?:her|his|their|my)\\s+life\\b"},
    {"id": "SI-MEANS-SELF", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:using|use|shoot|shooting)\\s+(?:it|that|them|the (?:gun|knife|rope|blade|pills|weapon))?\\s*on\\s*my\\s?self\\b|\\bshoot\\s*my\\s?self\\b|\\bhang\\s*my\\s?self\\b"},
    {"id": "SI-WANT-SLEEP", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:want|wish|wanna|wana)\\s+to\\s+sleep\\s+forever\\b"},
    {"id": "SI-ENDING-THOUGHTS", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:thinking|thought|think|thinks)\\s+(?:about|of)\\s+ending\\s+(?:things|it all|everything|my life|myself)\\b"},
    {"id": "SI-GONE", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:ill|im going to|i am going to|i wont|i will)\\s+be\\s+gone\\s+(?:soon|for good|forever)\\b"},
    {"id": "SI-PILLS-ALL", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "\\b(?:going to|gonna|plan to|planning to|decided to|about to|want to)\\s+(?:take|swallow)\\s+(?:them|those|these|it|everything)\\s+(?:all|at once)\\b(?!\\s+(?:to|out|with|home|in|back|on|over|for))"},
    {"id": "SQ-WANT-DIE", "category": "suicidal_ideation", "severity": "high", "action": "escalate", "self_directed": true, "pattern": "(?:want|wanna|wana|wish)to(?:die|bedead)"},
    {"id": "RV-BURDEN", "category": "distress_signal", "severity": "low", "action": "review", "self_directed": false, "pattern": "\\b(?:i am|im|i was|i feel like|i feel)\\s+(?:a\\s+)?burden\\b"},
    {"id": "RV-NO-FUTURE", "category": "distress_signal", "severity": "low", "action": "review", "self_directed": false, "pattern": "\\b(?:dont|cant|cannot|do not|can not)\\s+see\\s+(?:a|any)\\s+future\\b"},
    {"id": "AU-STALKED-NOW", "category": "abuse_or_unsafe_situation", "severity": "high", "action": "escalate", "self_directed": false, "pattern": "\\b(?:is|are|keeps|keep|has been|have been)\\s+(?:stalking|harassing|threatening)\\s+me\\b"},
    {"id": "RV-HOPELESS", "category": "distress_signal", "severity": "low", "action": "review", "self_directed": false, "pattern": "\\b(?:hopeless|worthless|empty inside|whats the point|what is the point|nothing matters|want to disappear|wann?a disappear|(?:no one|nobody) would (?:even\\s+)?(?:care|notice|miss me)|cant (?:do|take) this anymore|giving up on everything|give up on everything)\\b"}
  ],
  "negations": [
    {"id": "NG-NOT-SUICIDAL", "pattern": "\\b(?:im|i am|i was|im really|i am really)\\s+not\\s+(?:suicidal|going to (?:kill|hurt|harm) my\\s?self|planning (?:to|on) (?:kill|hurt|harm)\\w* my\\s?self)\\b"},
    {"id": "NG-NEVER", "pattern": "\\b(?:i\\s+)?(?:would|will|could)\\s+never\\s+(?:kill|hurt|harm|end)\\s+(?:my\\s?self|my life)\\b|\\bnever\\s+(?:been|felt)\\s+suicidal\\b"},
    {"id": "NG-DONT-WANT", "pattern": "\\b(?:i\\s+)?(?:dont|do not|wont|will not)\\s+(?:want to\\s+|ever\\s+)?(?:kill|hurt|harm)\\s+(?:my\\s?self|him|her|them|anyone|anybody|someone|their feelings|his feelings|her feelings)\\b"},
    {"id": "NG-NOT-GOING", "pattern": "\\bnot\\s+(?:going|planning|trying)\\s+to\\s+(?:kill|hurt|harm|end)\\s+(?:my\\s?self|my life|him|her|them|anyone)\\b"}
  ],
  "ambivalence": "\\b(?:but|though|although|except|sometimes|yet|lately)\\b"
}
