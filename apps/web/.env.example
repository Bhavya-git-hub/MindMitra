# MindMitra web app. Copy to .env.local for development. Never commit real values.

# Browser-visible base URL of the MindMitra API (no trailing path).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Where the Next.js server reaches the API (defaults to the URL above). Server-side only.
# API_INTERNAL_URL=http://api:8000

# Signs the HttpOnly "portal pass" cookie that drives role redirects. At least 32 random
# characters, for example: openssl rand -base64 48. Server-side only.
SESSION_SECRET=

# The /design-system showcase is development-only unless this is "true".
# ENABLE_DESIGN_SYSTEM=false
