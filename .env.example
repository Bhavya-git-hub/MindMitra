# Copy to .env and fill in locally. Never commit real values.

# --- Shared ---
# Required (development | test | staging | production). There is no default.
# staging/production additionally require TLS on the DB URL (?ssl=require).
APP_ENV=development

# --- Backend (services/api) ---
API_SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://mindmitra:change-me@localhost:5432/mindmitra
REDIS_URL=redis://localhost:6379/0
# Base64 of 32 random bytes. Generate: python -c "from app.core.crypto import generate_key; print(generate_key())"
FIELD_ENCRYPTION_KEY=change-me
# Ed25519 key that signs access JWTs (PEM, or base64 of the PEM on one line). Generate:
# python -c "import base64;from app.core.access_tokens import generate_private_key_pem as g;print(base64.b64encode(g().encode()).decode())"
JWT_PRIVATE_KEY=change-me
# Optional auth tuning (defaults shown)
# ACCESS_TOKEN_TTL_SECONDS=600
# REFRESH_TOKEN_TTL_SECONDS=604800
# STUDENT_SESSION_MAX_SECONDS=2592000
# STAFF_SESSION_MAX_SECONDS=43200
# LOGIN_LOCKOUT_THRESHOLD=5
# AUTH_RATE_LIMIT_PER_MINUTE=20
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000

# Database pool (optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=false

# Seed (development only): password for all synthetic users; if unset a random one is printed once
# SEED_USER_PASSWORD=

# Tests: a server URL where the test user may CREATE DATABASE
# TEST_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/postgres

# --- ML service (services/ml) ---
ML_MODEL_DIR=./artifacts
ML_SERVICE_TOKEN_EXPECTED=change-me

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Signs the portal-pass cookie. 32+ random characters: openssl rand -base64 48 (server-side only)
SESSION_SECRET=change-me

# --- Local Postgres (docker-compose) ---
POSTGRES_USER=mindmitra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mindmitra
